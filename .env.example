# CRYPTORA - Firebase Production & Local Environment Configuration
# Add these environment variables in your Vercel Project Settings (Project -> Settings -> Environment Variables)
# for Production, Preview, and Development.

# Required:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# Recommended (OAuth & Storage):
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Optional Cloud Firestore Database Identifier:
# Use VITE_FIREBASE_FIRESTORE_DATABASE_ID or VITE_FIREBASE_FIRESTORE (alias)
# Leave empty or omit if using the standard (default) Firestore database.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_FIRESTORE=