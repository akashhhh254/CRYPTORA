rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document: only the authenticated user can read or modify their profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User history subcollection: only the user can read, create, or delete their history
      match /history/{operationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
